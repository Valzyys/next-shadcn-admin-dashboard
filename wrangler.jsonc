{
  "name": "studio-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API",
      "service": "jkt48connect-cf"
    }
  ],
  "vars": {
    "API_BASE_URL": "https://v5.jkt48connect.com"
  }
}
